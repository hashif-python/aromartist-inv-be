DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=development-only-perfumosol-change-before-deploying
DJANGO_DEBUG=1
POSTGRES_DB=perfumosol
POSTGRES_USER=perfumosol
POSTGRES_PASSWORD=local-development-only
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
JWT_COOKIE_SECURE=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Host ports and frontend build-time API address
AROMA_BE_PORT=8000
AROMA_FE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
AROMA_DB_VOLUME=aroma_postgres_data

# WhatsApp Evolution-compatible provider (server-side only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,eco-opportunities-plugins-artificial.trycloudflare.com
